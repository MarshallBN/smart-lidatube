SMART_DB_PATH=/lidatube/config/smart-lidatube.db
SMART_API_TOKEN=replace-with-long-random-token
ACOUSTID_API_KEY=
NAVIDROME_URL=http://navidrome:4533/rest
NAVIDROME_USER=
NAVIDROME_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123
TELEGRAM_ALLOWED_CHAT_IDS=123
DOWNLOADS_ROOT=/lidatube/downloads
# Root where Lidarr sees the same host volume; it may differ from DOWNLOADS_ROOT.
LIDARR_DOWNLOADS_ROOT=/lidatube/downloads
NAVIDROME_MUSIC_ROOT=/music
# Lidarr reports organized track files under this root. The audit mapping only accepts paths beneath it.
LIDARR_MUSIC_ROOT=/Music
# Read-only library mount inside smart-worker (mount host Music2 here as /music:ro).
SMART_AUDIT_MUSIC_ROOT=/music
LIDARR_ADDRESS=http://lidarr:8686
LIDARR_API_KEY=
# Optional review-only slskd discovery. No transfers are implemented. All four
# values are required; conflict state must explicitly clear Soularr and Lidarr.
# Example live endpoint: http://192.168.50.166:5030
SLSKD_URL=
SLSKD_API_KEY=
SLSKD_RESULT_CAP=20
SLSKD_CONNECT_TIMEOUT=2
SLSKD_READ_TIMEOUT=5
SMART_CONFLICT_STATE_URL=
SMART_CONFLICT_STATE_TOKEN=
SMART_CLAIM_TIMEOUT=300
SMART_RETRY_DELAY=30
SMART_MAX_ATTEMPTS=5
# Auto retries are deadline-bound (24h) by default; optionally set a separate cap.
# SMART_AUTO_MAX_ATTEMPTS=24
SMART_IMPORT_VERIFY_INTERVAL=10
SMART_IMPORT_VERIFY_TIMEOUT=900
SMART_WORKER_HEALTH_MAX_AGE=60
SMART_POLL_INTERVAL=10
# Read-only library auditor: defaults are deliberately conservative.
SMART_AUDIT_ENABLED=true
# Milestone A permits observe, review, or paused. Automatic auditor upgrades are disabled.
SMART_AUDIT_MODE=observe
SMART_VERSION=source
SMART_FFPROBE_TIMEOUT=10
# Adaptive tier ceiling; effective audit rate is min(backlog tier, this max).
SMART_AUDIT_MAX_PER_HOUR=300
# Legacy installs may keep SMART_AUDIT_VERIFY_BUDGET_PER_HOUR as the ceiling.
SMART_AUDIT_MAX_LOAD_PER_CPU=0.75
SMART_AUDIT_MAX_DISK_IO_MS=250
SMART_AUDIT_MAX_FINGERPRINT_WORKERS=2
SMART_AUDIT_ACOUSTID_CONCURRENCY=1
SMART_AUDIT_FAIRNESS_SHARE=0.20
SMART_AUDIT_MAX_TOKEN_BANK=24
SMART_AUDIT_IDLE_GRACE_SECONDS=600
SMART_AUDIT_CANDIDATE_SEARCH_BUDGET_PER_HOUR=0
# Candidate discovery remains disabled by default; do not raise this during Milestone A.
SMART_AUDIT_REPORT_TIME=20:00
SMART_AUDIT_TIMEZONE=UTC
SMART_AUDIT_REPORT_EMPTY=false
TELEGRAM_REVIEW_CHAT_ID=123
