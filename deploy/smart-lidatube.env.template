# --- Existing LidaTube/Lidarr connection ---
# Set this to the URL reachable FROM these containers.
# Examples: http://lidarr:8686 (same Docker network) or http://HOST_IP:8686
LIDARR_ADDRESS=http://lidarr:8686
LIDARR_API_KEY=REPLACE_WITH_LIDARR_API_KEY
LIDARR_API_TIMEOUT=120

# Lidarr sees this same host volume at this path INSIDE the Lidarr container.
# If Lidarr mounts /mnt/PizzaPool/MediaServer/Music2 as /music, set /music here.
# If it mounts it as /lidatube/downloads, retain /lidatube/downloads.
LIDARR_DOWNLOADS_ROOT=/lidatube/downloads

# --- Smart worker local state ---
SMART_DB_PATH=/lidatube/config/smart-lidatube.db
SMART_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
DOWNLOADS_ROOT=/lidatube/downloads
SMART_CLAIM_TIMEOUT=300
SMART_RETRY_DELAY=30
SMART_MAX_ATTEMPTS=5
SMART_IMPORT_VERIFY_INTERVAL=10
SMART_IMPORT_VERIFY_TIMEOUT=900
SMART_WORKER_HEALTH_MAX_AGE=60
SMART_POLL_INTERVAL=10
# Read-only library audit: no source search/download/import occurs in this phase.
SMART_AUDIT_ENABLED=true
SMART_AUDIT_VERIFY_BUDGET_PER_HOUR=12
SMART_AUDIT_MAX_FINGERPRINT_WORKERS=2
SMART_AUDIT_ACOUSTID_CONCURRENCY=1
SMART_AUDIT_FAIRNESS_SHARE=0.20
SMART_AUDIT_MAX_TOKEN_BANK=24
SMART_AUDIT_IDLE_GRACE_SECONDS=600
SMART_AUDIT_CANDIDATE_SEARCH_BUDGET_PER_HOUR=0
SMART_AUDIT_REPORT_TIME=20:00
SMART_AUDIT_TIMEZONE=UTC
SMART_AUDIT_REPORT_EMPTY=false

# --- AcoustID ---
# Leave empty to run without acoustic auto-verification; candidates go to review.
ACOUSTID_API_KEY=

# --- Navidrome ---
# URL reachable from the smart-worker container. Include /rest.
NAVIDROME_URL=http://navidrome:4533/rest
NAVIDROME_USER=REPLACE_WITH_DEDICATED_NAVIDROME_USER
NAVIDROME_PASSWORD=REPLACE_WITH_NAVIDROME_PASSWORD

# Translate a Navidrome playlist song path to Lidarr's path when their mounts differ.
NAVIDROME_MUSIC_ROOT=/music
LIDARR_MUSIC_ROOT=/music

# --- Telegram ---
# Optional but required for Manual Retry and uncertain automatic candidates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=972408992
TELEGRAM_ALLOWED_CHAT_IDS=972408992
TELEGRAM_REVIEW_CHAT_ID=972408992

# Optional yt-dlp Netscape cookie file path inside the container.
# Put the file at /mnt/PizzaPool/Config/Lidatube/cookies.txt if needed.
YTDLP_COOKIES=/lidatube/config/cookies.txt

# --- Existing LidaTube settings ---
attempt_lidarr_import=True
thread_limit=4
PUID=1000
PGID=1000
